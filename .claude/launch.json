{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lekafit/api", "dev"],
      "port": 3000,
      "env": {
        "DATABASE_URL": "postgres://lekafit:lekafit@localhost:5433/lekafit",
        "BOT_TOKEN": "123456:LOCAL-DEV-TOKEN",
        "COACH_TELEGRAM_ID": "1000",
        "WEBAPP_URL": "http://localhost:5173",
        "START_BOT": "false"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lekafit/web", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
